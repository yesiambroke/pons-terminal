# Optional CLI private key. Prefer the terminal vault for multi-wallet trading:
#   npm run terminal  →  import / generate wallets inside the app
# NEVER commit this file with a real key. NEVER paste keys into shell history.
PRIVATE_KEY=

# Robinhood Chain RPC (default works for most users)
RPC_URL=https://rpc.arrowrpc.com

# Master encryption key for the multi-wallet vault (AES-256-GCM).
# First `npm run ui` generates this automatically if missing.
# Or create one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENC_KEY=

# NOTE: HOODL router addresses are embedded in the app (src/config.ts).
# You do not set ROUTER_ADDRESS or V2_ROUTER_ADDRESS — every trade routes
# through the built-in fee-bearing routers so Pons Terminal stays funded.
